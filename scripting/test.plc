# inline comments not allowed
# cascade Transistor array 3 times
for i 1 3
    for q 30 37
        # Turn T08P4 outputs on
        echo setting output Q00$q 1
        output Q00$q 1
        sleep 0.5
    end

    sleep 3

    for q 30 37
        # Turn T08P4 outputs off
        echo setting output Q00$q 0
        output Q00$q 0
        sleep 0.5
    end
end 

